{
  "$comment": "Generated by \"pnpm docs:generate\" from packages/engine/src/config/schema.ts and the catalog. Do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyclopsgd/Mediaplane/main/docs/reference/stack.schema.json",
  "title": "Mediaplane stack.yaml, version 1",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1,
      "description": "The version of this file's format. Always 1."
    },
    "timezone": {
      "default": "Etc/UTC",
      "description": "The timezone the apps run in, as a tz database name such as Europe/London.",
      "type": "string",
      "minLength": 1
    },
    "user": {
      "default": {
        "uid": 1000,
        "gid": 1000
      },
      "description": "The user and group the apps run as. They must be able to write to paths.data.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "The user id."
        },
        "gid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "The group id."
        }
      },
      "required": ["uid", "gid"],
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string",
          "pattern": "^\\/",
          "description": "The data folder for downloads and media, mounted in the apps as /data. Keep both on one filesystem inside it, so moves are instant hardlinks. An absolute path, without \":\"."
        }
      },
      "required": ["data"],
      "additionalProperties": false,
      "description": "Where your media lives."
    },
    "network": {
      "default": {
        "bind": "lan"
      },
      "description": "Where the web UIs are published.",
      "type": "object",
      "properties": {
        "bind": {
          "default": "lan",
          "description": "lan: on this host's private (RFC 1918) addresses. localhost: on 127.0.0.1 only. all: on every interface, and plan warns every time. On a cloud VM, lan needs lan_subnet.",
          "type": "string",
          "enum": ["lan", "localhost", "all"]
        },
        "lan_subnet": {
          "description": "Your LAN as an IPv4 CIDR, such as 192.168.1.0/24. Detected from this host's private addresses when left out; on a cloud VM, bind: lan needs it set.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "security": {
      "default": {
        "login_on_lan": true
      },
      "description": "Login settings.",
      "type": "object",
      "properties": {
        "login_on_lan": {
          "default": true,
          "description": "Ask for a login from your own network too. false lets Sonarr, Radarr and Prowlarr skip it for addresses in the LAN subnet.",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "admin": {
      "default": {
        "username": "admin"
      },
      "description": "The shared admin login for the apps that have one. Not used yet: the apps' logins are set up from Slice 3.",
      "type": "object",
      "properties": {
        "username": {
          "default": "admin",
          "description": "The admin user name. Not used yet (Slice 3).",
          "type": "string",
          "minLength": 1
        },
        "password": {
          "description": "The admin password, as a secret reference. Checked to exist, but not used yet: from Slice 3, a password is generated when this is left out.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A file that holds the secret, relative to the Mediaplane home, such as secrets/wg.key."
                }
              },
              "required": ["file"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "env": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
