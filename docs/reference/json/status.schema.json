{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyclopsgd/Mediaplane/main/docs/reference/json/status.schema.json",
  "$comment": "Generated by \"pnpm docs:generate\" from packages/cli/src/contract.ts. Do not edit.",
  "title": "mediaplane.status/v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "mediaplane.status/v1"
    },
    "ok": {
      "type": "boolean",
      "const": true,
      "description": "true: the containers were listed"
    },
    "healthy": {
      "type": "boolean",
      "description": "there are containers, and every one is running and passes its health check"
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "description": "the Compose service"
          },
          "state": {
            "type": "string",
            "description": "running, exited, created, …"
          },
          "health": {
            "type": "string",
            "description": "healthy, unhealthy, starting, or empty with no health check"
          },
          "published": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string",
                  "description": "the host address"
                },
                "port": {
                  "type": "number"
                },
                "protocol": {
                  "type": "string",
                  "enum": ["tcp", "udp"]
                }
              },
              "required": ["address", "port", "protocol"],
              "additionalProperties": false
            },
            "description": "where its ports are published on the host"
          }
        },
        "required": ["service", "state", "health", "published"],
        "additionalProperties": false
      },
      "description": "the stack's containers, sorted by service"
    },
    "lastApply": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "the change record, as `mediaplane history <id>` takes it"
            },
            "startedAt": {
              "type": "string",
              "description": "when the apply started, in ISO 8601"
            },
            "durationMs": {
              "type": "number",
              "description": "how long it took"
            },
            "outcome": {
              "type": "string",
              "enum": ["success", "failed"]
            },
            "changes": {
              "type": "object",
              "properties": {
                "files": {
                  "type": "number",
                  "description": "files written"
                },
                "containers": {
                  "type": "number",
                  "description": "containers changed"
                },
                "secrets": {
                  "type": "number",
                  "description": "secrets generated"
                },
                "wiring": {
                  "type": "number",
                  "description": "resources the wire step changed in the apps"
                }
              },
              "required": ["files", "containers", "secrets", "wiring"],
              "additionalProperties": false,
              "description": "how much it changed"
            }
          },
          "required": ["id", "startedAt", "durationMs", "outcome", "changes"],
          "additionalProperties": false,
          "description": "one apply, in short"
        },
        {
          "type": "null"
        }
      ],
      "description": "the last apply, or null if none has run"
    },
    "historyError": {
      "type": "string",
      "description": "why the change history couldn't be read; the containers are listed all the same"
    }
  },
  "required": ["schema", "ok", "healthy", "containers", "lastApply"],
  "additionalProperties": false,
  "description": "each app's container, and the last apply: `mediaplane status [app] --json`"
}
