{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyclopsgd/Mediaplane/main/docs/reference/json/vpn-check.schema.json",
  "$comment": "Generated by \"pnpm docs:generate\" from packages/cli/src/contract.ts. Do not edit.",
  "title": "mediaplane.vpn-check/v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "mediaplane.vpn-check/v1"
    },
    "ok": {
      "type": "boolean",
      "const": true,
      "description": "true: the check ran; verdict says what it found"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "leak", "down"],
      "description": "pass exits 0; leak and down exit 1"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": ["network", "gluetun", "control", "control-key", "route", "egress"]
          },
          "status": {
            "type": "string",
            "enum": ["ok", "warning", "down", "leak"]
          },
          "message": {
            "type": "string",
            "description": "what it found, for people"
          },
          "hint": {
            "type": "string",
            "description": "what to do about it"
          }
        },
        "required": ["id", "status", "message"],
        "additionalProperties": false
      },
      "description": "each check, in order"
    },
    "egress": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "the IP-echo service asked"
            },
            "vpn": {
              "description": "qBittorrent's address, or null",
              "type": ["string", "null"]
            },
            "host": {
              "description": "this host's address, or null",
              "type": ["string", "null"]
            }
          },
          "required": ["url", "vpn", "host"],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "the addresses compared; null with --no-egress"
    },
    "gluetunPublicIp": {
      "description": "the address Gluetun reports for itself, or null",
      "type": ["string", "null"]
    },
    "failClosed": {
      "type": "boolean",
      "description": "qBittorrent was shown to be in Gluetun's network, and nothing can get out around the VPN"
    }
  },
  "required": [
    "schema",
    "ok",
    "verdict",
    "checks",
    "egress",
    "gluetunPublicIp",
    "failClosed"
  ],
  "additionalProperties": false,
  "description": "whether qBittorrent reaches the internet only through the VPN: `mediaplane vpn-check --json`"
}
