              },
              "message": {
                "type": "string",
                "description": "what is wrong, for people"
              },
              "path": {
                "type": "string",
                "description": "where in `stack.yaml`, such as `apps.qbittorrent.vpn`"
              },
              "hint": {
                "type": "string",
                "description": "what to do about it"
              }
            },
            "required": ["severity", "code", "message"],
            "additionalProperties": false,
            "description": "a problem found"
          },
          "description": "the diagnostics that stopped the command, when it has them"
        }
      },
      "required": ["message"],
      "additionalProperties": false
    }
  },
  "required": ["schema", "ok", "error"],
  "additionalProperties": false,
  "description": "a command that stopped before it could print its own document: a usage error, a missing `stack.yaml` for credentials or vpn-check, Docker out of reach"
