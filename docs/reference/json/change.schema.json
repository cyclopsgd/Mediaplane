{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyclopsgd/Mediaplane/main/docs/reference/json/change.schema.json",
  "$comment": "Generated by \"pnpm docs:generate\" from packages/cli/src/contract.ts. Do not edit.",
  "title": "mediaplane.change/v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "mediaplane.change/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}Z-[0-9a-f]{8}$",
      "description": "the record, such as `20261009T094312Z-a1b2c3d4`"
    },
    "trigger": {
      "type": "string",
      "const": "cli"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outcome": {
      "type": "string",
      "enum": ["success", "failed"]
    },
    "stackSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "the SHA-256 of `stack.yaml` as applied"
    },
    "plan": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "relative to the Mediaplane home"
              },
              "status": {
                "type": "string",
                "enum": ["create", "update", "unchanged"]
              }
            },
            "required": ["path", "status"],
            "additionalProperties": false
          }
        },
        "containers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "service": {
                "type": "string",
                "description": "the Compose service, such as sonarr"
              },
              "action": {
                "type": "string",
                "enum": ["create", "recreate", "start", "restart", "remove", "unchanged"]
              }
            },
            "required": ["service", "action"],
            "additionalProperties": false
          }
        },
        "secrets": {
          "type": "object",
          "properties": {
            "generate": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "the secrets generated, by name"
            },
            "recover": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "the keys recovered from the apps' appdata"
            },
            "restore": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "the keys put back in their apps' own files"
            }
          },
          "required": ["generate"],
          "additionalProperties": false,
          "description": "names only, never values"
        },
        "wiring": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "resource": {
                "type": "string",
                "description": "`<app>.<resource>`, or `<app>` alone for an app Mediaplane only checks"
              },
              "action": {
                "type": "string",
                "enum": [
                  "create",
                  "update",
                  "adopt",
                  "unchanged",
                  "after-start",
                  "unknown",
                  "remove"
                ],
                "description": "adopt: the app holds it as wanted, and Mediaplane records it; after-start: checked once its app runs; unknown: Mediaplane could not ask the app (`reason` says why); remove: Mediaplane made it, and the stack no longer wants it"
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "the managed fields and secrets that differ, by name"
              },
              "reason": {
                "type": "string",
                "description": "why it could not be checked"
              }
            },
            "required": ["resource", "action"],
            "additionalProperties": false
          }
        },
        "bootstrap": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "app": {
                "type": "string",
                "description": "the app whose first-run setup apply finishes, such as jellyfin"
              },
              "unpublished": {
                "type": "boolean",
                "description": "it starts with no published port until its setup is done"
              },
              "again": {
                "type": "boolean",
                "description": "present, and true, only when the setup signs in again with what you rotated (`--rotate plex.token`), published or not"
              }
            },
            "required": ["app", "unpublished"],
            "additionalProperties": false
          }
        }
      },
      "required": ["files", "containers", "secrets"],
      "additionalProperties": false,
      "description": "the plan the apply followed, without its diffs"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "keys",
              "files",
              "pull",
              "ownership",
              "start",
              "bootstrap",
              "wire",
              "verify"
            ]
          },
          "resource": {
            "type": "string",
            "description": "the wire step names the resource, such as `sonarr.admin`"
          },
          "result": {
            "type": "string",
            "enum": ["done", "failed", "skipped"]
          },
          "detail": {
            "type": "string",
            "description": "what it did. A `wire` action that names a `resource` and is `done` says exactly one of these, stable within v1: `created`, `adopted`, `unchanged`, `removed`, or `updated` and then the names of what changed, comma-separated, as the plan's `changes` names them (`updated user, password`). Otherwise it is for people: a skipped wire action says why, such as why a planned removal stays; the wire step's action with no `resource` sums up the others; the first-run setup step says what it set up and published, and `signed in again to <app>`"
          },
          "error": {
            "type": "string",
            "description": "why it failed"
          }
        },
        "required": ["step", "result"],
        "additionalProperties": false
      }
    },
    "ok": {
      "type": "boolean",
      "const": true,
      "description": "true: the record was read"
    }
  },
  "required": [
    "schema",
    "id",
    "trigger",
    "startedAt",
    "finishedAt",
    "durationMs",
    "outcome",
    "stackSha256",
    "plan",
    "actions",
    "ok"
  ],
  "additionalProperties": false,
  "description": "one change record, as this release knows it: `mediaplane history <id> --json`. A later release's record shows only these fields; the rest stay in its file"
}
