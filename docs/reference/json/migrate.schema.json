{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyclopsgd/Mediaplane/main/docs/reference/json/migrate.schema.json",
  "$comment": "Generated by \"pnpm docs:generate\" from packages/cli/src/contract.ts. Do not edit.",
  "title": "mediaplane.migrate/v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "mediaplane.migrate/v1"
    },
    "ok": {
      "type": "boolean",
      "description": "`stack.yaml` is now, or already was, the version this Mediaplane writes"
    },
    "from": {
      "type": "number",
      "description": "the version `stack.yaml` was, when it could be read"
    },
    "to": {
      "type": "number",
      "description": "the version this Mediaplane writes"
    },
    "changed": {
      "type": "boolean",
      "description": "`stack.yaml` was rewritten"
    },
    "applied": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "what each migration step changed, in order"
    },
    "text": {
      "type": "string",
      "description": "the file as it should be, when Mediaplane may not write it (`managed_by: external`)"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["error", "warning"],
            "description": "an error stopped the command; a warning did not"
          },
          "code": {
            "type": "string",
            "description": "what it is, such as `config.unknown-key`: stable, for scripts to act on; the message is for people and may change"
          },
          "message": {
            "type": "string",
            "description": "what is wrong, for people"
          },
          "path": {
            "type": "string",
            "description": "where in `stack.yaml`, such as `apps.qbittorrent.vpn`"
          },
          "hint": {
            "type": "string",
            "description": "what to do about it"
          }
        },
        "required": ["severity", "code", "message"],
        "additionalProperties": false,
        "description": "a problem found"
      },
      "description": "every error and warning, in the order found"
    }
  },
  "required": ["schema", "ok", "to", "changed", "applied", "diagnostics"],
  "additionalProperties": false,
  "description": "what migrate did: `mediaplane migrate --json`"
}
