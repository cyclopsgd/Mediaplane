{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/cyclopsgd/Mediaplane/main/docs/reference/json/history.schema.json",
  "$comment": "Generated by \"pnpm docs:generate\" from packages/cli/src/contract.ts. Do not edit.",
  "title": "mediaplane.history/v1",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "mediaplane.history/v1"
    },
    "ok": {
      "type": "boolean",
      "const": true,
      "description": "true: the records were listed"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "the change record, as `mediaplane history <id>` takes it"
          },
          "startedAt": {
            "type": "string",
            "description": "when the apply started, in ISO 8601"
          },
          "durationMs": {
            "type": "number",
            "description": "how long it took"
          },
          "outcome": {
            "type": "string",
            "enum": ["success", "failed"]
          },
          "changes": {
            "type": "object",
            "properties": {
              "files": {
                "type": "number",
                "description": "files written"
              },
              "containers": {
                "type": "number",
                "description": "containers changed"
              },
              "secrets": {
                "type": "number",
                "description": "secrets generated"
              },
              "wiring": {
                "type": "number",
                "description": "resources the wire step changed in the apps"
              }
            },
            "required": ["files", "containers", "secrets", "wiring"],
            "additionalProperties": false,
            "description": "how much it changed"
          }
        },
        "required": ["id", "startedAt", "durationMs", "outcome", "changes"],
        "additionalProperties": false,
        "description": "one apply, in short"
      },
      "description": "every change record, newest first"
    },
    "unreadable": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "the files in `state/history/` this Mediaplane can't read: a later release's, or damaged"
    }
  },
  "required": ["schema", "ok", "records", "unreadable"],
  "additionalProperties": false,
  "description": "the change records: `mediaplane history --json`"
}
