#!/usr/bin/env sh
# Scan staged changes for secrets before every commit.
# Uses a local gitleaks if installed, otherwise the pinned gitleaks container.
set -e
IMAGE='ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f'
ROOT="$(git rev-parse --show-toplevel)"
# The git dir can live outside ROOT (linked worktrees), so mount both at identical paths.
COMMON="$(cd "$(git rev-parse --git-common-dir)" && pwd -P)"

if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git "$ROOT" --pre-commit --staged --redact --verbose --config "$ROOT/.gitleaks.toml"
elif command -v docker >/dev/null 2>&1; then
  # `git commit -a` and `git commit <path>` run this hook with GIT_INDEX_FILE pointing at a
  # temporary index. Forward it into the container, or the container would scan the stale
  # real index and miss what is actually being committed. ROOT and COMMON are physical
  # paths and are what get mounted, so the index path must be canonicalized the same way
  # (a symlinked checkout path would otherwise not exist inside the container). If it
  # cannot be located under a mounted path, fail closed rather than skip the scan.
  if [ -n "${GIT_INDEX_FILE:-}" ]; then
    case "$GIT_INDEX_FILE" in
      /*) INDEX="$GIT_INDEX_FILE" ;;
      *) INDEX="$PWD/$GIT_INDEX_FILE" ;;
    esac
    INDEX_DIR="$(cd "$(dirname "$INDEX")" 2>/dev/null && pwd -P)" || INDEX_DIR=''
    INDEX="$INDEX_DIR/$(basename "$INDEX")"
    case "$INDEX" in
      "$ROOT"/* | "$COMMON"/*) ;;
      *)
        echo "pre-commit: GIT_INDEX_FILE ($GIT_INDEX_FILE) is not under the repo or its git dir; refusing to commit unscanned" >&2
        exit 1
        ;;
    esac
    if [ ! -f "$INDEX" ]; then
      echo "pre-commit: index file $INDEX does not exist; refusing to commit unscanned" >&2
      exit 1
    fi
    set -- -e "GIT_INDEX_FILE=$INDEX"
  else
    set --
  fi
  exec docker run --rm --user "$(id -u):$(id -g)" "$@" -v "$ROOT:$ROOT" -v "$COMMON:$COMMON" -w "$ROOT" "$IMAGE" \
    git "$ROOT" --pre-commit --staged --redact --verbose --config "$ROOT/.gitleaks.toml"
else
  echo "pre-commit: neither gitleaks nor docker found; secret scan SKIPPED" >&2
fi
